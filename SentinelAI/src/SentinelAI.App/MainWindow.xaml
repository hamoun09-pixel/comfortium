<Window x:Class="SentinelAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SentinelAI.App.ViewModels"
        Title="SentinelAI — analyse locale (V0.1)"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource Fond}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel>

        <!-- Bandeau -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="SentinelAI" FontSize="20" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource TexteSecondaire}"
                           Text="Deuxième niveau de surveillance, en complément de Microsoft Defender. Aucune donnée n'est envoyée sur Internet." />
            </StackPanel>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Etat}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{StaticResource TexteSecondaire}"
                           Text="{Binding DossierDonnees, StringFormat=Données : {0}}" />
            </Grid>
        </Border>

        <TabControl Margin="12" BorderBrush="{StaticResource Bordure}">

            <!-- ================= Analyse ================= -->
            <TabItem Header="Analyse">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cible et actions -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding Cible, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="Chemin du fichier ou du dossier à analyser" />
                        <Button Grid.Column="1" Content="Choisir un fichier…" Command="{Binding ChoisirFichierCommande}" MinWidth="150" />
                        <Button Grid.Column="2" Content="Choisir un dossier…" Command="{Binding ChoisirDossierCommande}" MinWidth="150" Margin="0" />
                    </Grid>

                    <!-- Options -->
                    <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                        <Button Content="Analyser" Command="{Binding AnalyserCommande}" FontWeight="SemiBold" />
                        <Button Content="Arrêter" Command="{Binding ArreterCommande}" />
                        <CheckBox Content="Inclure les sous-dossiers" IsChecked="{Binding Recursif}"
                                  VerticalAlignment="Center" Margin="12,0,16,0" />
                        <CheckBox Content="Types sensibles seulement (.exe, .dll, .ps1, …)"
                                  IsChecked="{Binding TypesSensiblesUniquement}"
                                  VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="Afficher aussi les fichiers sans indicateur"
                                  IsChecked="{Binding AfficherTout}" VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Progression -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,8">
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Avancement}" />
                        <TextBlock Text="{Binding FichierCourant}" Style="{StaticResource Aide}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Synthese}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NombreAffiche}" Style="{StaticResource Aide}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Résultats et détail -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding Resultats}"
                                  SelectedItem="{Binding Selection}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Niveau" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="7,2" Margin="2"
                                                    Background="{Binding Niveau, Converter={StaticResource NiveauCouleur}}">
                                                <TextBlock Text="{Binding Niveau, Converter={StaticResource NiveauLibelle}}"
                                                           Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60" />
                                <DataGridTextColumn Header="Fichier" Binding="{Binding Nom}" Width="2*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Categorie}" Width="110" />
                                <DataGridTextColumn Header="Signature" Binding="{Binding Signature, Converter={StaticResource Signature}}" Width="110" />
                                <DataGridTextColumn Header="Taille" Binding="{Binding Taille, Converter={StaticResource Taille}}" Width="90" />
                                <DataGridTextColumn Header="Chemin" Binding="{Binding Chemin}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Bordure}" BorderThickness="1" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Détail de l'évaluation" Style="{StaticResource Titre}" />
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Mettre en quarantaine" Command="{Binding MettreEnQuarantaineCommande}" MinWidth="170" />
                                    <Button Content="Ouvrir l'emplacement" Command="{Binding OuvrirEmplacementCommande}" MinWidth="150" Margin="0" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding DetailSelection, Mode=OneWay}"
                                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= Journal ================= -->
            <TabItem Header="Journal">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Actualiser" Command="{Binding RafraichirCommande}" />
                        <Button Content="Ouvrir le dossier des journaux" Command="{Binding OuvrirJournalCommande}" MinWidth="220" Margin="0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Analyses}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Debut, Converter={StaticResource DateLocale}}" Width="140" />
                            <DataGridTextColumn Header="Cible" Binding="{Binding Cible}" Width="*" />
                            <DataGridTextColumn Header="Fichiers" Binding="{Binding FichiersAnalyses}" Width="80" />
                            <DataGridTextColumn Header="À vérifier" Binding="{Binding Suspects}" Width="80" />
                            <DataGridTextColumn Header="Critiques" Binding="{Binding Critiques}" Width="80" />
                            <DataGridTextColumn Header="Erreurs" Binding="{Binding Erreurs}" Width="70" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Détections enregistrées" Style="{StaticResource Titre}" Margin="0,14,0,6" />

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Detections}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding AnalyseLe, Converter={StaticResource DateLocale}}" Width="140" />
                            <DataGridTextColumn Header="Niveau" Binding="{Binding Niveau, Converter={StaticResource NiveauLibelle}}" Width="90" />
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60" />
                            <DataGridTextColumn Header="Fichier" Binding="{Binding Nom}" Width="2*" />
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*" />
                            <DataGridTextColumn Header="Chemin" Binding="{Binding Chemin}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= Quarantaine ================= -->
            <TabItem Header="Quarantaine">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Aide}"
                               Text="Les fichiers mis en quarantaine sont chiffrés dans un coffre local : ils ne peuvent plus être exécutés, et la restauration reste possible tant que vous ne les supprimez pas définitivement." />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Actualiser" Command="{Binding RafraichirCommande}" />
                        <Button Content="Ouvrir le dossier de données" Command="{Binding OuvrirDonneesCommande}" MinWidth="210" Margin="0" />
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ElementsQuarantaine}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding MiseEnQuarantaineLe, Converter={StaticResource DateLocale}}" Width="140" />
                            <DataGridTextColumn Header="État" Binding="{Binding EtatLibelle}" Width="150" />
                            <DataGridTextColumn Header="Fichier" Binding="{Binding Nom}" Width="*" />
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="60" />
                            <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="2*" />
                            <DataGridTextColumn Header="Emplacement d'origine" Binding="{Binding CheminOrigine}" Width="3*" />
                            <DataGridTemplateColumn Header="Actions" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Restaurer" MinWidth="90" Padding="8,3"
                                                    Command="{Binding DataContext.RestaurerCommande, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Supprimer" MinWidth="90" Padding="8,3" Margin="0"
                                                    Command="{Binding DataContext.SupprimerDefinitivementCommande, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= Paramètres ================= -->
            <TabItem Header="Paramètres">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="820" HorizontalAlignment="Left">

                        <TextBlock Text="Fonctionnement" Style="{StaticResource Titre}" />
                        <TextBlock Style="{StaticResource Aide}"
                                   Text="SentinelAI V0.1 effectue des analyses manuelles, à la demande. Il ne remplace pas Microsoft Defender et ne le désactive jamais : il ajoute un second regard, avec ses propres règles et un score expliqué. Toute l'analyse est locale." />

                        <TextBlock Text="Analyse" Style="{StaticResource Titre}" Margin="0,12,0,6" />
                        <TextBlock Style="{StaticResource Aide}">
                            <Run Text="Empreinte SHA-256 calculée pour chaque fichier." /><LineBreak />
                            <Run Text="Types sensibles surveillés : .exe, .dll, .msi, .ps1, .bat, .cmd, .js, .vbs et variantes proches." /><LineBreak />
                            <Run Text="{Binding EtatSignature, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="Règles locales" Style="{StaticResource Titre}" Margin="0,12,0,6" />
                        <TextBlock Style="{StaticResource Aide}">
                            <Run Text="{Binding NombreRegles, Mode=OneWay, StringFormat=Règles de détection chargées : {0}}" /><LineBreak />
                            <Run Text="{Binding NombreEmpreintes, Mode=OneWay, StringFormat=Empreintes SHA-256 bloquées : {0}}" /><LineBreak />
                            <Run Text="{Binding DossierRegles, Mode=OneWay, StringFormat=Vos règles personnelles (fichiers .json) : {0}}" />
                        </TextBlock>

                        <TextBlock Text="Emplacements" Style="{StaticResource Titre}" Margin="0,12,0,6" />
                        <TextBlock Style="{StaticResource Aide}">
                            <Run Text="{Binding DossierDonnees, Mode=OneWay, StringFormat=Dossier de données : {0}}" /><LineBreak />
                            <Run Text="{Binding FichierBase, Mode=OneWay, StringFormat=Base SQLite : {0}}" /><LineBreak />
                            <Run Text="{Binding DossierJournaux, Mode=OneWay, StringFormat=Journaux : {0}}" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Ouvrir le dossier de données" Command="{Binding OuvrirDonneesCommande}" MinWidth="210" />
                            <Button Content="Ouvrir les journaux" Command="{Binding OuvrirJournalCommande}" MinWidth="170" Margin="0" />
                        </StackPanel>

                        <TextBlock Text="À venir" Style="{StaticResource Titre}" Margin="0,18,0,6" />
                        <TextBlock Style="{StaticResource Aide}"
                                   Text="V0.2 : surveillance en temps réel des dossiers sensibles (FileSystemWatcher). V0.3 : transmission des scripts à l'antimalware du poste via AMSI." />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
