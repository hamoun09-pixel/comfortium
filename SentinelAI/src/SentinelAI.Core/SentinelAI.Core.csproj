<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SentinelAI.Core</RootNamespace>
    <AssemblyName>SentinelAI.Core</AssemblyName>
    <!-- La bibliotheque cible net10.0 (et non net10.0-windows) afin de rester
         compilable et testable hors Windows. Les appels specifiques a Windows
         sont annotes [SupportedOSPlatform("windows")] et proteges a l'execution. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rules\regles-par-defaut.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SentinelAI.Core.Tests" />
  </ItemGroup>

</Project>
